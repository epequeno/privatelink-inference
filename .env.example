# Copy to .env and fill in. Nothing here is real.
# Account ids, ARNs and endpoint ids are deliberately NOT committed — see LOCAL.md.
#
# This file is NOT auto-loaded (no dotenv dependency). Load it with:
#     set -a; source .env; set +a
# Values marked "stack output" come from `just deploy` — see the CfnOutput names.

AWS_PROFILE=arch
AWS_REGION=us-east-1

# Set from the provider stack outputs after `just deploy`.
PRIVATELINK_SERVICE_NAME=

# Set from the provider stack outputs — used by `just egress`.
FLOW_LOG_GROUP=
PROVIDER_VPC_CIDR=
INFERENCE_SUBNET_CIDRS=

# Set from the consumer stack outputs.
ENDPOINT_DNS_NAME=
PROBE_FUNCTION_NAME=          # consumer output `ProbeFunctionName`
SAGEMAKER_PROBE_FUNCTION_NAME=  # consumer output `SageMakerProbeFunctionName`

# Set from the SageMaker stack outputs.
SAGEMAKER_ARTIFACT_BUCKET=    # `ArtifactBucket`
SAGEMAKER_TRAINING_ROLE_ARN=  # `TrainingRoleArn`
SAGEMAKER_MODEL_PACKAGE_GROUP=  # `ModelPackageGroupName`

# Endpoint list price in USD/hour, used only for the $/1k figure in the probe.
SAGEMAKER_HOURLY_RATE=1.41
